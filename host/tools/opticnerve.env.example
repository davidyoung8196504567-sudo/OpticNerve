# OpticNerve settings: copy to ~/.config/opticnerve/env (or point ON_CONFIG at another file) and chmod 600 it.
# The scripts read it through host/tools/on_env.sh, host/tools/on_env.py and the Java tests' cfg(). A value given on
# a script's command line wins, then one already in the environment, then this file, then the default shown.
# One NAME='VALUE' per line (no ' inside), taken literally: no $ expansion. A line that doesn't fit is skipped;
# docs/SETTINGS.md has the grammar and every script's parameters. Never commit a filled-in copy.

# The target (the QNX device running the OpticNerve agent)
ON_HOST='10.30.1.116'          # the agent's VNC address
ON_VNC_PORT='5901'             # the agent's VNC port
#ON_SSH_HOST='127.0.0.1'       # SSH address, when it differs from ON_HOST (default: ON_HOST)
#ON_SSH_PORT='2222'            # SSH port (default 22)
ON_LOGIN_USER='qnxuser'        # SSH login on the target, also used for sudo
ON_LOGIN_PASSWORD=''           # that login's password
ON_VNC_PASSWORD=''             # the agent's VNC password

# The QEMU target (host/qemu/tunnel.sh)
#ON_QEMU_HOST='10.30.1.104'    # the Linux host running the guest
#ON_GUEST='192.168.122.146'    # the guest's address on that host
#ON_UBUNTU_PASSWORD=''         # the tester login on ON_QEMU_HOST

# OBS on this host (host/tools/obs_control.py)
#ON_OBS_HOST='127.0.0.1'
#ON_OBS_PORT='4455'
#ON_OBS_PASSWORD=''            # default: read from OBS's own websocket settings

# The PoC tester (host/poc/poc-env.sh)
#ON_JAVA='/home/tester/opticnerve-work/jdk/jdk17/bin/java'           # default: that path under your home
#ON_OCULIX_JAR='/home/tester/qtb1/oculixide-5.0.0-complete-lux.jar'   # default: that path under your home
#ON_TESTS='/home/tester/ide-tests'                                    # default: ~/ide-tests
#ON_LOGS='/home/tester/ide-session'                                   # default: ~/ide-session
# The SDP for sut.sh build is QNX_SDP_DIR (default ~/qnx805), an environment variable, not read from this file.
